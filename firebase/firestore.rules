rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidLanguage(lang) {
      return lang in ['en', 'hi', 'bn', 'te', 'mr', 'ta', 'gu'];
    }

    function isValidTheme(theme) {
      return theme in ['light', 'dark'];
    }

    // 1. User accounts & profile ownership
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'citizen'
        && request.resource.data.consentAccepted == true
        && isValidLanguage(request.resource.data.preferredLanguage)
        && isValidTheme(request.resource.data.themePreference);
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidLanguage(request.resource.data.preferredLanguage)
        && isValidTheme(request.resource.data.themePreference);
      allow delete: if isOwner(userId);
    }

    // 2. Public Government Scheme Catalog (Verified/Verification Required readable; Archived/Draft admin-only)
    match /schemes/{schemeId} {
      allow read: if resource.data.verificationStatus in ['Verified', 'Verification Required', 'Needs Review'] || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // 3. User-scoped Saved Schemes
    match /savedSchemes/{docId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.schemeId is string;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // 4. User-scoped Self-Reported Applications
    match /applications/{applicationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in [
          'Not Started',
          'Checking Eligibility',
          'Collecting Documents',
          'Ready to Apply',
          'Submitted',
          'Under Review',
          'Approved',
          'Rejected',
          'Follow-Up Required'
        ];
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // 5. User-scoped Notifications
    match /notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // 6. User-scoped Personal Reminders
    match /reminders/{reminderId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // 7. User-scoped AI Assistant Conversations & Messages
    match /conversations/{conversationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isValidLanguage(request.resource.data.language);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    match /messages/{messageId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role in ['user', 'assistant'];
      allow update: if false;
    }

    // 8. User-scoped Rejection Notice Analyses
    match /rejectionAnalyses/{analysisId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 9. Citizen Feedback Submissions (create allowed; admin reads/reviews)
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 1500
        && request.resource.data.status == 'Open'
        && (!isSignedIn() || request.resource.data.userId == request.auth.uid);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // 10. Immutable Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
